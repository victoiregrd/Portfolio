    border-block: 2px solid var(--texte);
    overflow: hidden; white-space: nowrap;
  }
  .bandeau div {
    display: inline-block;
    font-size: clamp(1.4rem, 4vw, 2.2rem); font-weight: 800; text-transform: uppercase; /* tout en majuscules */
