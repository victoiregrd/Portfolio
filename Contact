    --rose: #f6c9dc;    /* encadré quand on le survole */
    --menthe: #bfe8d2;  /* encadré une fois copié */
    --texte: #2b2433;   /* texte et contours */
  }

  /* ============ BASE DE LA PAGE ============ */
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; }
  body {
    background: var(--fond);
    color: var(--texte);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    display: flex; flex-direction: column;   /* en-tête, contenu, pied de page empilés */
    min-height: 100vh;
    overflow-x: hidden;                      /* évite le défilement horizontal du bandeau */
  }

  /* ============ EN-TÊTE (liens de retour) ============ */
  header { display: flex; justify-content: space-between; align-items: center; padding: 20px 32px; }
  header a { color: inherit; text-decoration: none; font-weight: 600; }
  header a:hover { text-decoration: underline; }

  /* ============ CONTENU CENTRAL ============ */
  main {
    flex: 1;                                  /* prend toute la place disponible */
    display: flex; flex-direction: column; justify-content: center;
    padding: 24px 32px 48px;
    max-width: 880px; width: 100%; margin: 0 auto;
  }
  .question { font-size: clamp(1.1rem, 2.5vw, 1.4rem); font-weight: 700; margin: 0 0 12px; }

  /* ============ BANDEAU QUI DÉFILE ============ */
  .bandeau {
    margin: 0 -32px 32px; padding: 14px 0;    /* marge négative : le bandeau va d'un bord à l'autre */
